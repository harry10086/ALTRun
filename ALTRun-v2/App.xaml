<Application x:Class="ALTRun.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="Application_Startup"
             Exit="Application_Exit"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
        <!-- 全局控件样式（TextBox/CheckBox/ComboBox/ContextMenu/MenuItem/Separator 等）
             已拆分到 Themes/Controls.xaml，运行时由 ThemeManager 动态接管配色。 -->
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Themes/Controls.xaml"/>
        </ResourceDictionary.MergedDictionaries>

        <!-- 现代深色模式初始调色板 (运行时由 ThemeManager 动态接管) -->
        <Color x:Key="BgColor">#E61E1E24</Color>
        <Color x:Key="CardBgColor">#F22B2B36</Color>
        <Color x:Key="BorderColor">#40FFFFFF</Color>
        <Color x:Key="AccentColor">#0078D4</Color>
        <Color x:Key="AccentHoverColor">#198AEB</Color>
        <Color x:Key="TextColor">#FFFFFF</Color>
        <Color x:Key="TextMutedColor">#99FFFFFF</Color>
        <Color x:Key="BadgeBgColor">#33FFFFFF</Color>
        <Color x:Key="HoverBgColor">#20FFFFFF</Color>
        <Color x:Key="HighlightBgColor">#330078D4</Color>

        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
        <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
        <SolidColorBrush x:Key="BadgeBgBrush" Color="{StaticResource BadgeBgColor}"/>
        <SolidColorBrush x:Key="HoverBgBrush" Color="{StaticResource HoverBgColor}"/>
        <SolidColorBrush x:Key="HighlightBgBrush" Color="{StaticResource HighlightBgColor}"/>

        <!-- 窗口与子页面通用画刷映射 -->
        <SolidColorBrush x:Key="WindowBg" Color="{StaticResource BgColor}"/>
        <SolidColorBrush x:Key="CardBg" Color="{StaticResource CardBgColor}"/>
        <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextMutedColor}"/>
        <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}"/>
        <SolidColorBrush x:Key="InputBg" Color="{StaticResource CardBgColor}"/>
        <SolidColorBrush x:Key="InputBorder" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="BtnBg" Color="{StaticResource CardBgColor}"/>
        <SolidColorBrush x:Key="BtnFg" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="BtnBorder" Color="{StaticResource BorderColor}"/>

        <!-- 现代通用字体规范 -->
        <FontFamily x:Key="MainFont">Segoe UI, Microsoft YaHei UI, sans-serif</FontFamily>
        <FontFamily x:Key="CodeFont">Consolas, Cascadia Code, monospace</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>