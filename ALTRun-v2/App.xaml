<Application x:Class="ALTRun.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="Application_Startup"
             Exit="Application_Exit"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- 现代深色模式调色板 -->
        <Color x:Key="BgColor">#E61E1E24</Color>
        <Color x:Key="CardBgColor">#F22B2B36</Color>
        <Color x:Key="BorderColor">#40FFFFFF</Color>
        <Color x:Key="AccentColor">#0078D4</Color>
        <Color x:Key="AccentHoverColor">#198AEB</Color>
        <Color x:Key="TextColor">#FFFFFF</Color>
        <Color x:Key="TextMutedColor">#99FFFFFF</Color>
        <Color x:Key="BadgeBgColor">#33FFFFFF</Color>
        <Color x:Key="HighlightBgColor">#330078D4</Color>

        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
        <SolidColorBrush x:Key="BadgeBgBrush" Color="{StaticResource BadgeBgColor}"/>
        <SolidColorBrush x:Key="HighlightBgBrush" Color="{StaticResource HighlightBgColor}"/>

        <!-- 现代字体规范 -->
        <FontFamily x:Key="MainFont">Segoe UI Variable Display, Microsoft YaHei UI, sans-serif</FontFamily>
        <FontFamily x:Key="CodeFont">Cascadia Code, Consolas, monospace</FontFamily>
    </Application.Resources>
</Application>
