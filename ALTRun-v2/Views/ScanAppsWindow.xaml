<Window x:Class="ALTRun.Views.ScanAppsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ALTRun - 扫描并导入本机已安装软件"
        Height="680"
        Width="920"
        MinHeight="500"
        MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}"
        FontSize="15"
        FontFamily="Segoe UI Variable Display, Microsoft YaHei UI, sans-serif">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBg" Color="#18181C"/>
        <SolidColorBrush x:Key="CardBg" Color="#222228"/>
        <SolidColorBrush x:Key="RowBg" Color="#202026"/>
        <SolidColorBrush x:Key="RowAltBg" Color="#25252D"/>
        <SolidColorBrush x:Key="RowHoverBg" Color="#2E3442"/>
        <SolidColorBrush x:Key="RowSelectedBg" Color="#27374D"/>
        <SolidColorBrush x:Key="HeaderBg" Color="#1A1A20"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#35FFFFFF"/>
        <SolidColorBrush x:Key="InputBg" Color="#18181C"/>
        <SolidColorBrush x:Key="InputBorder" Color="#40FFFFFF"/>
        <SolidColorBrush x:Key="BtnBg" Color="#2A2A32"/>
        <SolidColorBrush x:Key="BtnFg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BtnBorder" Color="#40FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8"/>
        <SolidColorBrush x:Key="BadgeBg" Color="#3038BDF8"/>

        <!-- 现代通用按钮样式 -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BtnFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 强调按钮 -->
        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- CheckBox 样式 -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 顶部说明与过滤 -->
            <RowDefinition Height="*"/>    <!-- 数据表格 -->
            <RowDefinition Height="Auto"/> <!-- 底部状态与操作按钮 -->
        </Grid.RowDefinitions>

        <!-- 1. 顶部操作栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 说明文本 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="⚡ 本机已安装软件智能扫描" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="已自动从开始菜单与桌面检索，并智能过滤卸载程序、帮助手册及辅助工具。您可以勾选想要导入的软件并直接修改快捷词。"
                           FontSize="13" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- 工具栏：搜索过滤与全选操作 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtFilter"
                         Grid.Column="0"
                         FontSize="14"
                         Padding="12,8"
                         Background="{DynamicResource InputBg}"
                         Foreground="{DynamicResource TextPrimary}"
                         CaretBrush="{DynamicResource AccentBrush}"
                         BorderBrush="{DynamicResource InputBorder}"
                         BorderThickness="1"
                         Margin="0,0,14,0"
                         VerticalAlignment="Center"
                         TextChanged="TxtFilter_TextChanged"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="全选新软件" Style="{StaticResource ModernBtn}" Click="BtnSelectAll_Click" Margin="0,0,6,0"/>
                    <Button Content="全部取消" Style="{StaticResource ModernBtn}" Click="BtnDeselectAll_Click" Margin="0,0,6,0"/>
                    <Button Content="🔄 重新扫描" Style="{StaticResource ModernBtn}" Click="BtnRescan_Click"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 2. 数据表格 -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="0">
            <Grid>
                <!-- 正在扫描提示 -->
                <StackPanel x:Name="PnlLoading" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="⏳ 正在扫描本机应用与快捷方式，请稍候..." FontSize="16" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 结果列表 DataGrid -->
                <DataGrid x:Name="GridApps"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeColumns="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                          Background="Transparent"
                          Foreground="{DynamicResource TextPrimary}"
                          BorderThickness="0"
                          RowHeight="38"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource HeaderBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{DynamicResource RowBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            <Style.Triggers>
                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="{DynamicResource RowAltBg}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource RowHoverBg}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource RowSelectedBg}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!-- 勾选导入列 -->
                        <DataGridTemplateColumn Header="导入" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                              Click="CheckBox_Click"
                                              Style="{StaticResource ModernCheckBox}"
                                              HorizontalAlignment="Center"
                                              IsEnabled="{Binding IsAlreadyExists, Converter={x:Null}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 快捷词编辑列 -->
                        <DataGridTemplateColumn Header="快捷词 (按键)" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding ShortCut, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="13"
                                             FontWeight="Bold"
                                             FontFamily="Cascadia Code, Consolas, monospace"
                                             Foreground="{DynamicResource AccentBrush}"
                                             Background="{DynamicResource InputBg}"
                                             BorderBrush="{DynamicResource BorderBrush}"
                                             BorderThickness="1"
                                             Padding="6,3"
                                             VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 软件名称列 (自适应比例宽度，支持窗口拉大与悬浮提示) -->
                        <DataGridTextColumn Header="软件名称" Binding="{Binding Name}" Width="2*" MinWidth="180" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="ToolTip" Value="{Binding Name}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 状态/来源 -->
                        <DataGridTemplateColumn Header="状态" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#3010B981"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAlreadyExists}" Value="True">
                                                        <Setter Property="Background" Value="#2564748B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="新软件"/>
                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAlreadyExists}" Value="True">
                                                            <Setter Property="Text" Value="已存在"/>
                                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 目标路径 (自适应比例宽度，支持窗口拉大与悬浮提示) -->
                        <DataGridTextColumn Header="可执行文件路径" Binding="{Binding TargetPath}" Width="3*" MinWidth="240" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="ToolTip" Value="{Binding TargetPath}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 3. 底部状态与操作按钮 -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 统计信息 -->
            <TextBlock x:Name="TxtStatus"
                       Grid.Column="0"
                       Text="共发现 0 个软件，已勾选 0 个"
                       FontSize="14"
                       Foreground="{DynamicResource TextMuted}"
                       VerticalAlignment="Center"/>

            <!-- 操作按钮 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnImportSelected"
                        Content="✓ 导入勾选软件"
                        Style="{StaticResource AccentBtn}"
                        Padding="20,9"
                        Click="BtnImportSelected_Click"/>
                <Button Content="关闭"
                        Style="{StaticResource ModernBtn}"
                        Padding="16,9"
                        Margin="10,0,0,0"
                        Click="BtnCancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
