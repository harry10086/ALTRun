<Window x:Class="ALTRun.Views.ManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:ALTRun.Services"
        Title="{x:Static svc:AppStrings.ManageWindowTitle}"
        Height="720"
        Width="1040"
        MinHeight="520"
        MinWidth="760"
        WindowStartupLocation="Manual"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}"
        FontSize="16"
        FontFamily="Segoe UI, Microsoft YaHei UI, sans-serif">

    <Window.Resources>
        <!-- 基础色彩画刷初始值 (默认深色模式) -->
        <SolidColorBrush x:Key="WindowBg" Color="#18181C"/>
        <SolidColorBrush x:Key="CardBg" Color="#222228"/>
        <SolidColorBrush x:Key="RowBg" Color="#202026"/>
        <SolidColorBrush x:Key="RowAltBg" Color="#25252D"/>
        <SolidColorBrush x:Key="RowHoverBg" Color="#2E3442"/>
        <SolidColorBrush x:Key="RowSelectedBg" Color="#27374D"/>
        <SolidColorBrush x:Key="HeaderBg" Color="#1A1A20"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#35FFFFFF"/>
        <SolidColorBrush x:Key="InputBg" Color="#18181C"/>
        <SolidColorBrush x:Key="InputBorder" Color="#40FFFFFF"/>
        <SolidColorBrush x:Key="BtnBg" Color="#2A2A32"/>
        <SolidColorBrush x:Key="BtnFg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BtnBorder" Color="#40FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="GridLine" Color="#20FFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8"/>
        <SolidColorBrush x:Key="BadgeBg" Color="#3038BDF8"/>

        <!-- 现代通用按钮样式 (统一 6px 圆角 + 悬停微高亮) -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BtnFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource HighlightBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 重点高亮按钮 -->
        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 顶部搜索过滤与主操作 -->
            <RowDefinition Height="Auto"/> <!-- 全局热键配置卡片 -->
            <RowDefinition Height="*"/>    <!-- 数据表格 -->
            <RowDefinition Height="Auto"/> <!-- 底部编辑表单 -->
        </Grid.RowDefinitions>

        <!-- 1. 顶部工具栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 搜索过滤输入框 -->
            <TextBox x:Name="TxtFilter"
                     Grid.Column="0"
                     FontSize="15"
                     Padding="14,9"
                     Background="{DynamicResource InputBg}"
                     Foreground="{DynamicResource TextPrimary}"
                     CaretBrush="{DynamicResource AccentBrush}"
                     BorderBrush="{DynamicResource InputBorder}"
                     BorderThickness="1"
                     Margin="0,0,16,0"
                     VerticalAlignment="Center"
                     TextChanged="TxtFilter_TextChanged"/>

            <!-- 操作按钮组 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource AccentBtn}" Click="BtnAdd_Click" ToolTip="{x:Static svc:AppStrings.TooltipAddNew}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                              Fill="{DynamicResource AccentTextBrush}"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,6,0"/>
                        <TextBlock Text="{x:Static svc:AppStrings.BtnAddNew}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ModernBtn}" Click="BtnScanApps_Click" ToolTip="{x:Static svc:AppStrings.TooltipScanApps}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                              Fill="{DynamicResource BtnFg}"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,6,0"/>
                        <TextBlock Text="{x:Static svc:AppStrings.BtnScanApps}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ModernBtn}" Click="BtnDelete_Click" ToolTip="{x:Static svc:AppStrings.TooltipDeleteSelected}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19M8,9H16V19H8V9M9,11V17H11V11H9M13,11V17H15V11H13Z"
                              Fill="{DynamicResource BtnFg}"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,6,0"/>
                        <TextBlock Text="{x:Static svc:AppStrings.BtnDeleteSelected}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ModernBtn}" Click="BtnImport_Click" ToolTip="{x:Static svc:AppStrings.TooltipImportList}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M11,4H4A2,2 0 0,0 2,6V20A2,2 0 0,0 4,22H18A2,2 0 0,0 20,20V13H18V20H4V6H11V4M19.5,6L18.09,7.41L15,4.33V14H13V4.33L9.91,7.41L8.5,6L14,0.5L19.5,6Z"
                              Fill="{DynamicResource BtnFg}"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5"
                              Margin="0,0,6,0">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleY="-1"/>
                            </Path.RenderTransform>
                        </Path>
                        <TextBlock Text="{x:Static svc:AppStrings.BtnImportList}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ModernBtn}" Click="BtnExport_Click" ToolTip="{x:Static svc:AppStrings.TooltipExportList}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M11,4H4A2,2 0 0,0 2,6V20A2,2 0 0,0 4,22H18A2,2 0 0,0 20,20V13H18V20H4V6H11V4M19.5,6L18.09,7.41L15,4.33V14H13V4.33L9.91,7.41L8.5,6L14,0.5L19.5,6Z"
                              Fill="{DynamicResource BtnFg}"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,6,0"/>
                        <TextBlock Text="{x:Static svc:AppStrings.BtnExportList}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnToggleTheme" Style="{StaticResource ModernBtn}" Click="BtnToggleTheme_Click" ToolTip="{x:Static svc:AppStrings.TooltipToggleTheme}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A3.5,3.5 0 0,0 15.5,18.5C15.5,18.16 15.38,17.84 15.17,17.58C14.96,17.33 14.83,17 14.83,16.67A1.67,1.67 0 0,1 16.5,15H18A4,4 0 0,0 22,11C22,6.03 17.5,2 12,2M12,4C16.41,4 20,7.13 20,11A2,2 0 0,1 18,13H16.5A3.67,3.67 0 0,0 12.83,16.67C12.83,17.39 13.15,18.05 13.66,18.53C13.84,18.78 13.5,19.34 13.5,18.5A1.5,1.5 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M6.5,10A1.5,1.5 0 0,0 5,11.5A1.5,1.5 0 0,0 6.5,13A1.5,1.5 0 0,0 8,11.5A1.5,1.5 0 0,0 6.5,10M9.5,6A1.5,1.5 0 0,0 8,7.5A1.5,1.5 0 0,0 9.5,9A1.5,1.5 0 0,0 11,7.5A1.5,1.5 0 0,0 9.5,6M14.5,6A1.5,1.5 0 0,0 13,7.5A1.5,1.5 0 0,0 14.5,9A1.5,1.5 0 0,0 16,7.5A1.5,1.5 0 0,0 14.5,6M17.5,10A1.5,1.5 0 0,0 16,11.5A1.5,1.5 0 0,0 17.5,13A1.5,1.5 0 0,0 19,11.5A1.5,1.5 0 0,0 17.5,10Z"
                              Fill="{DynamicResource BtnFg}"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,6,0"/>
                        <TextBlock Text="{x:Static svc:AppStrings.BtnToggleTheme}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnCheckUpdate" Style="{StaticResource ModernBtn}" Click="BtnCheckUpdate_Click" ToolTip="{x:Static svc:AppStrings.TooltipCheckUpdate}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                              Fill="{DynamicResource BtnFg}"
                              Width="13" Height="13"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,6,0"/>
                        <TextBlock Text="{x:Static svc:AppStrings.BtnCheckUpdateShort}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. 全局唤醒热键与外观主题风格配置卡片 -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,10"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：全局唤醒热键设置 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static svc:AppStrings.LabelHotKey}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <CheckBox x:Name="ChkAlt" Content="Alt" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox x:Name="ChkCtrl" Content="Ctrl" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox x:Name="ChkShift" Content="Shift" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox x:Name="ChkWin" Content="Win" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,14,0"/>

                    <TextBlock Text="{x:Static svc:AppStrings.LabelMainKey}" FontSize="15" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbKey" Width="90" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,14,0"/>

                    <Button Content="{x:Static svc:AppStrings.BtnSaveHotKey}" Style="{StaticResource AccentBtn}" Padding="14,6" FontSize="13" Click="BtnSaveHotKey_Click" ToolTip="{x:Static svc:AppStrings.TooltipSaveHotKey}"/>
                </StackPanel>

                <!-- 右侧：外观主题风格下拉框 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎨 主题风格:" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="CmbThemes" Width="205" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" SelectionChanged="CmbThemes_SelectionChanged" ToolTip="{x:Static svc:AppStrings.TooltipThemeCombo}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="13" Height="13" CornerRadius="6.5" Margin="0,0,8,0" VerticalAlignment="Center" BorderThickness="1" BorderBrush="#40FFFFFF">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding AccentColor}"/>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Description, StringFormat='({0})'}" FontSize="11.5" Opacity="0.65" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. 高对比度、防发蓝、清晰大字号表格卡片 (统一 8px 外观圆角) -->
        <Border Grid.Row="2"
                CornerRadius="8"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource CardBg}"
                ClipToBounds="True">
            <DataGrid x:Name="ShortcutGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{DynamicResource TextPrimary}"
                      FontSize="16"
                      RowHeight="48"
                      RowBackground="{DynamicResource RowBg}"
                      AlternatingRowBackground="{DynamicResource RowAltBg}"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource GridLine}"
                      SelectionMode="Single"
                      SelectionChanged="ShortcutGrid_SelectionChanged">

            <!-- 自定义单元格样式: 避免原生蓝色覆盖 -->
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter SnapsToDevicePixels="True"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.CellStyle>

            <!-- 自定义整行样式: 柔和高对比度背景 + 4px 醒目左指示条 -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridRow">
                                <Border x:Name="DgrBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <DataGridCellsPresenter SnapsToDevicePixels="True"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="DgrBorder" Property="Background" Value="{DynamicResource RowHoverBg}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="DgrBorder" Property="Background" Value="{DynamicResource RowSelectedBg}"/>
                                        <Setter TargetName="DgrBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="DgrBorder" Property="BorderThickness" Value="4,0,0,1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource HeaderBg}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="16,12"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <!-- 快捷词列：醒目亮天蓝、等宽、加粗 -->
                <DataGridTextColumn Header="{x:Static svc:AppStrings.GridHeaderShortCut}" Binding="{Binding ShortCut}" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="16,0"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="FontFamily" Value="Consolas, Cascadia Code, monospace"/>
                            <Setter Property="FontSize" Value="16"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 名称列：清晰纯白/深黑、半粗体 -->
                <DataGridTextColumn Header="{x:Static svc:AppStrings.GridHeaderName}" Binding="{Binding Name}" Width="280">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="16,0"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            <Setter Property="FontSize" Value="16"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 命令行路径：高对比明亮浅灰/深灰、代码等宽 -->
                <DataGridTextColumn Header="{x:Static svc:AppStrings.GridHeaderCommandLine}" Binding="{Binding CommandLine}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="16,0"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                            <Setter Property="FontFamily" Value="Consolas, Cascadia Code, monospace"/>
                            <Setter Property="FontSize" Value="15"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 频次列 -->
                <DataGridTextColumn Header="{x:Static svc:AppStrings.GridHeaderFreq}" Binding="{Binding Freq}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                            <Setter Property="FontSize" Value="15"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        </Border>

        <!-- 4. 底部快捷项编辑表单 (支持一键选择文件 / 目录) -->
        <Border Grid.Row="3"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20,18"
                Margin="0,16,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 第一行: 快捷词 & 名称 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static svc:AppStrings.LabelShortCut}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,14"/>
                <TextBox x:Name="EditShortCut" Grid.Row="0" Grid.Column="1" FontSize="16" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource InputBorder}" Padding="10,8" Margin="0,0,24,14"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Static svc:AppStrings.LabelName}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,14"/>
                <TextBox x:Name="EditName" Grid.Row="0" Grid.Column="3" FontSize="16" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource InputBorder}" Padding="10,8" Margin="0,0,24,14"/>

                <!-- 第二行: 命令行 & 浏览选择文件/目录按钮 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static svc:AppStrings.LabelCommandLine}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBox x:Name="EditCommandLine" Grid.Row="1" Grid.Column="1" FontSize="15" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource InputBorder}" Padding="10,8" Margin="0,0,14,0"/>

                <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Button Content="{x:Static svc:AppStrings.BtnBrowseFile}" Style="{StaticResource ModernBtn}" Margin="0,0,10,0" Padding="14,8" FontSize="14" Click="BtnBrowseFile_Click" ToolTip="{x:Static svc:AppStrings.TooltipBrowseFile}"/>
                    <Button Content="{x:Static svc:AppStrings.BtnBrowseFolder}" Style="{StaticResource ModernBtn}" Margin="0,0,10,0" Padding="14,8" FontSize="14" Click="BtnBrowseFolder_Click" ToolTip="{x:Static svc:AppStrings.TooltipBrowseFolder}"/>
                </StackPanel>

                <!-- 保存修改按钮 -->
                <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" Content="{x:Static svc:AppStrings.BtnSaveEdit}" Style="{StaticResource AccentBtn}" VerticalAlignment="Stretch" Padding="28,0" FontSize="16" Click="BtnSaveEdit_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
