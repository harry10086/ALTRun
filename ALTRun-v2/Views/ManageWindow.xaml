<Window x:Class="ALTRun.Views.ManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ALTRun - 快捷方式管理中心"
        Height="800"
        Width="1120"
        MinHeight="650"
        MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}"
        FontSize="16"
        FontFamily="Segoe UI Variable Display, Microsoft YaHei UI, sans-serif">

    <Window.Resources>
        <!-- 基础色彩画刷初始值 (默认深色模式) -->
        <SolidColorBrush x:Key="WindowBg" Color="#18181C"/>
        <SolidColorBrush x:Key="CardBg" Color="#222228"/>
        <SolidColorBrush x:Key="RowBg" Color="#202026"/>
        <SolidColorBrush x:Key="RowAltBg" Color="#25252D"/>
        <SolidColorBrush x:Key="RowHoverBg" Color="#2E3442"/>
        <SolidColorBrush x:Key="RowSelectedBg" Color="#27374D"/>
        <SolidColorBrush x:Key="HeaderBg" Color="#1A1A20"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#35FFFFFF"/>
        <SolidColorBrush x:Key="InputBg" Color="#18181C"/>
        <SolidColorBrush x:Key="InputBorder" Color="#40FFFFFF"/>
        <SolidColorBrush x:Key="BtnBg" Color="#2A2A32"/>
        <SolidColorBrush x:Key="BtnFg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BtnBorder" Color="#40FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="GridLine" Color="#20FFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8"/>
        <SolidColorBrush x:Key="BadgeBg" Color="#3038BDF8"/>

        <!-- 现代通用按钮样式 -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BtnFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 重点高亮按钮 -->
        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 顶部搜索过滤与主操作 -->
            <RowDefinition Height="Auto"/> <!-- 全局热键配置卡片 -->
            <RowDefinition Height="*"/>    <!-- 数据表格 -->
            <RowDefinition Height="Auto"/> <!-- 底部编辑表单 -->
        </Grid.RowDefinitions>

        <!-- 1. 顶部工具栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 搜索过滤输入框 -->
            <TextBox x:Name="TxtFilter"
                     Grid.Column="0"
                     FontSize="15"
                     Padding="14,9"
                     Background="{DynamicResource InputBg}"
                     Foreground="{DynamicResource TextPrimary}"
                     CaretBrush="{DynamicResource AccentBrush}"
                     BorderBrush="{DynamicResource InputBorder}"
                     BorderThickness="1"
                     Margin="0,0,16,0"
                     VerticalAlignment="Center"
                     TextChanged="TxtFilter_TextChanged"/>

            <!-- 操作按钮组 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="+ 新建项" Style="{StaticResource AccentBtn}" Click="BtnAdd_Click" ToolTip="新增一个快捷项目"/>
                <Button Content="删除选中" Style="{StaticResource ModernBtn}" Click="BtnDelete_Click" ToolTip="删除表格中当前选中的快捷方式"/>
                <Button Content="📥 导入列表" Style="{StaticResource ModernBtn}" Click="BtnImport_Click" ToolTip="支持导入 ShortCutList.txt / FavoriteList.txt / INI 等所有格式文件"/>
                <Button Content="📤 导出列表" Style="{StaticResource ModernBtn}" Click="BtnExport_Click" ToolTip="导出为标准 ShortCutList.txt"/>
                <Button x:Name="BtnToggleTheme" Content="🎨 快速换主题" Style="{StaticResource ModernBtn}" Click="BtnToggleTheme_Click" ToolTip="在预置的高质感主题间快速循环切换"/>
            </StackPanel>
        </Grid>

        <!-- 2. 全局唤醒热键与外观主题风格配置卡片 -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,10"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：全局唤醒热键设置 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⌨ 唤醒热键:" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <CheckBox x:Name="ChkAlt" Content="Alt" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox x:Name="ChkCtrl" Content="Ctrl" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox x:Name="ChkShift" Content="Shift" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox x:Name="ChkWin" Content="Win" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,14,0"/>

                    <TextBlock Text="主键:" FontSize="15" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbKey" Width="90" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,14,0"/>

                    <Button Content="💾 保存热键" Style="{StaticResource AccentBtn}" Padding="14,6" FontSize="13" Click="BtnSaveHotKey_Click" ToolTip="更新全局唤醒热键并立即生效"/>
                </StackPanel>

                <!-- 右侧：外观主题风格下拉框 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎨 主题风格:" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="CmbThemes" Width="190" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" SelectionChanged="CmbThemes_SelectionChanged" ToolTip="切换主界面与管理器外观配色风格"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. 高对比度、防发蓝、清晰大字号表格 -->
        <DataGrid x:Name="ShortcutGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  Background="{DynamicResource CardBg}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  Foreground="{DynamicResource TextPrimary}"
                  FontSize="16"
                  RowHeight="48"
                  RowBackground="{DynamicResource RowBg}"
                  AlternatingRowBackground="{DynamicResource RowAltBg}"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource GridLine}"
                  SelectionMode="Single"
                  SelectionChanged="ShortcutGrid_SelectionChanged">

            <!-- 自定义单元格样式: 避免原生蓝色覆盖 -->
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter SnapsToDevicePixels="True"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.CellStyle>

            <!-- 自定义整行样式: 柔和高对比度背景 + 4px 醒目左指示条 -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridRow">
                                <Border x:Name="DgrBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <DataGridCellsPresenter SnapsToDevicePixels="True"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="DgrBorder" Property="Background" Value="{DynamicResource RowHoverBg}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="DgrBorder" Property="Background" Value="{DynamicResource RowSelectedBg}"/>
                                        <Setter TargetName="DgrBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="DgrBorder" Property="BorderThickness" Value="4,0,0,1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource HeaderBg}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="16,12"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <!-- 快捷词列：醒目亮天蓝、等宽、加粗 -->
                <DataGridTextColumn Header="快捷词" Binding="{Binding ShortCut}" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="16,0"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace"/>
                            <Setter Property="FontSize" Value="16"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 名称列：清晰纯白/深黑、半粗体 -->
                <DataGridTextColumn Header="名称 / 说明" Binding="{Binding Name}" Width="280">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="16,0"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            <Setter Property="FontSize" Value="16"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 命令行路径：高对比明亮浅灰/深灰、代码等宽 -->
                <DataGridTextColumn Header="命令行 / 目标路径" Binding="{Binding CommandLine}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="16,0"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace"/>
                            <Setter Property="FontSize" Value="15"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 频次列 -->
                <DataGridTextColumn Header="频次" Binding="{Binding Freq}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                            <Setter Property="FontSize" Value="15"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 4. 底部快捷项编辑表单 (支持一键选择文件 / 目录) -->
        <Border Grid.Row="3"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20,18"
                Margin="0,16,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 第一行: 快捷词 & 名称 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="快捷词:" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,14"/>
                <TextBox x:Name="EditShortCut" Grid.Row="0" Grid.Column="1" FontSize="16" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource InputBorder}" Padding="10,8" Margin="0,0,24,14"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="名 称:" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,14"/>
                <TextBox x:Name="EditName" Grid.Row="0" Grid.Column="3" FontSize="16" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource InputBorder}" Padding="10,8" Margin="0,0,24,14"/>

                <!-- 第二行: 命令行 & 浏览选择文件/目录按钮 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="命令行:" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBox x:Name="EditCommandLine" Grid.Row="1" Grid.Column="1" FontSize="15" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource InputBorder}" Padding="10,8" Margin="0,0,14,0"/>

                <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Button Content="📄 选择文件..." Style="{StaticResource ModernBtn}" Margin="0,0,10,0" Padding="14,8" FontSize="14" Click="BtnBrowseFile_Click" ToolTip="直接浏览并选取可执行程序(.exe)、桌面快捷方式(.lnk)或任意文档"/>
                    <Button Content="📁 选择目录..." Style="{StaticResource ModernBtn}" Margin="0,0,10,0" Padding="14,8" FontSize="14" Click="BtnBrowseFolder_Click" ToolTip="选取常用文件夹目录"/>
                </StackPanel>

                <!-- 保存修改按钮 -->
                <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" Content="✔ 保存修改" Style="{StaticResource AccentBtn}" VerticalAlignment="Stretch" Padding="28,0" FontSize="16" Click="BtnSaveEdit_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
