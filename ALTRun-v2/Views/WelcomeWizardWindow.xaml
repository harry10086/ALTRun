<Window x:Class="ALTRun.Views.WelcomeWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:ALTRun.Services"
        Title="{x:Static svc:AppStrings.WizardHeader}"
        Height="480"
        Width="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        FontFamily="Segoe UI, Microsoft YaHei UI, sans-serif">

    <Border Background="#1C1C22"
            BorderBrush="#40FFFFFF"
            BorderThickness="1"
            CornerRadius="12"
            Padding="32,28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Color="#000000" Opacity="0.6" Direction="270" ShadowDepth="6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 标题与图标 -->
                <RowDefinition Height="*"/>    <!-- 说明介绍卡片 -->
                <RowDefinition Height="Auto"/> <!-- 按钮操作区 -->
            </Grid.RowDefinitions>

            <!-- 1. 标题区 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🚀" FontSize="28" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Static svc:AppStrings.WizardHeader}" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{x:Static svc:AppStrings.WizardSlogan}" FontSize="13" Foreground="#94A3B8" Margin="40,4,0,0"/>
            </StackPanel>

            <!-- 2. 说明卡片 -->
            <Border Grid.Row="1"
                    Background="#24242C"
                    BorderBrush="#25FFFFFF"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16"
                    Margin="0,0,0,24">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="💡 首次运行初始化设置" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>
                    <TextBlock Text="{x:Static svc:AppStrings.WizardIntro}"
                               FontSize="13" Foreground="#E2E8F0" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,12"/>

                    <Border Background="#1A1A20" CornerRadius="6" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="{x:Static svc:AppStrings.WizardFeatureFiltering}" FontSize="12" Foreground="#10B981" Margin="0,0,0,4"/>
                            <TextBlock Text="{x:Static svc:AppStrings.WizardFeatureLightweight}" FontSize="12" Foreground="#10B981" Margin="0,0,0,4"/>
                            <TextBlock Text="{x:Static svc:AppStrings.WizardFeatureManageable}" FontSize="12" Foreground="#10B981"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 3. 操作按钮 -->
            <StackPanel Grid.Row="2">
                <!-- 加载中动画提示 (默认隐藏) -->
                <StackPanel x:Name="PnlScanning" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock Text="{x:Static svc:AppStrings.WizardScanning}" FontSize="14" Foreground="#38BDF8"/>
                </StackPanel>

                <Grid x:Name="PnlButtons">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 一键推荐导入 -->
                    <Button x:Name="BtnAutoImport"
                            Grid.Column="0"
                            Height="42"
                            Background="#38BDF8"
                            Foreground="#000000"
                            BorderThickness="0"
                            FontSize="14"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="BtnAutoImport_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <TextBlock Text="{x:Static svc:AppStrings.WizardAutoImportButton}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 手动挑选 -->
                    <Button x:Name="BtnCustomSelect"
                            Grid.Column="1"
                            Height="42"
                            Padding="16,0"
                            Margin="10,0,0,0"
                            Background="#2E2E38"
                            Foreground="#FFFFFF"
                            BorderBrush="#40FFFFFF"
                            BorderThickness="1"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="BtnCustomSelect_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <TextBlock Text="📋 挑选导入..." HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 跳过 -->
                    <Button x:Name="BtnSkip"
                            Grid.Column="2"
                            Height="42"
                            Padding="14,0"
                            Margin="10,0,0,0"
                            Background="Transparent"
                            Foreground="#94A3B8"
                            BorderThickness="0"
                            FontSize="13"
                            Cursor="Hand"
                            Click="BtnSkip_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <TextBlock Text="{x:Static svc:AppStrings.WizardSkipButton}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
