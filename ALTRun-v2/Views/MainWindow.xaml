<Window x:Class="ALTRun.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:ALTRun.Services"
        Title="ALTRun"
        Width="660"
        Height="460"
        MinWidth="480"
        MinHeight="260"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Microsoft YaHei UI, sans-serif"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Deactivated="Window_Deactivated"
        Drop="Window_Drop"
        AllowDrop="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 列表项悬停与选中样式 -->
        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="12,9"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HighlightBgBrush}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 顶栏图标按钮通用样式 (带统一 6px 圆角悬停背景) -->
        <Style x:Key="TopIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource HighlightBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代沉浸式弹出菜单样式 (继承自 App.xaml 全局统一规范) -->
        <Style x:Key="ModernContextMenu" TargetType="ContextMenu" BasedOn="{StaticResource {x:Type ContextMenu}}"/>
        <Style x:Key="ModernMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"/>
        <Style x:Key="ModernMenuSeparator" TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}"/>
    </Window.Resources>

    <!-- 主外壳容器：高质感卡片 + 边框 -->
    <Border x:Name="MainContainer"
            Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 搜索栏 -->
                <RowDefinition Height="Auto"/> <!-- 分割线 -->
                <RowDefinition Height="*"/>    <!-- 结果列表 -->
                <RowDefinition Height="Auto"/> <!-- 底部状态栏 -->
            </Grid.RowDefinitions>

            <!-- 1. 顶部现代输入框 -->
            <Grid Grid.Row="0" Margin="18,14,18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 现代搜索标识 -->
                <TextBlock Grid.Column="0"
                           Text="›"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,2"/>

                <TextBox x:Name="SearchBox"
                         Grid.Column="1"
                         FontSize="19"
                         FontWeight="SemiBold"
                         MaxLength="256"
                         Foreground="{DynamicResource TextBrush}"
                         CaretBrush="{DynamicResource AccentBrush}"
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalAlignment="Center"
                         InputMethod.IsInputMethodEnabled="True"
                         InputMethod.PreferredImeState="Off"
                         InputMethod.PreferredImeConversionMode="Alphanumeric"
                         TextChanged="SearchBox_TextChanged">
                    <TextBox.Template>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>

                <!-- 占位符文字 -->
                <TextBlock x:Name="PlaceholderText"
                           Grid.Column="1"
                           Text="{x:Static svc:AppStrings.SearchPlaceholder}"
                           FontSize="16"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>

                <!-- 主题风格切换菜单 -->
                <Button Grid.Column="2"
                        x:Name="BtnTheme"
                        Style="{StaticResource TopIconButton}"
                        Margin="0,0,4,0"
                        ToolTip="{x:Static svc:AppStrings.TooltipThemeMenu}"
                        Click="BtnTheme_Click">
                    <Path Data="M12,3A9,9 0 0,0 3,12A9,9 0 0,0 12,21C13.4,21 14.5,19.9 14.5,18.5C14.5,17.8 14.2,17.2 13.8,16.8C13.4,16.4 13.1,15.8 13.1,15.2C13.1,14 14.1,13 15.3,13H17C19.2,13 21,11.2 21,9C21,5.7 17,3 12,3M6,12C5.4,12 5,11.6 5,11C5,10.4 5.4,10 6,10C6.6,10 7,10.4 7,11C7,11.6 6.6,12 6,12M9,8C8.4,8 8,7.6 8,7C8,6.4 8.4,6 9,6C9.6,6 10,6.4 10,7C10,7.6 9.6,8 9,8M15,8C14.4,8 14,7.6 14,7C14,6.4 14.4,6 15,6C15.6,6 16,6.4 16,7C16,7.6 15.6,8 15,8M18,12C17.4,12 17,11.6 17,11C17,10.4 17.4,10 18,10C18.6,10 19,10.4 19,11C19,11.6 18.6,12 18,12Z"
                          Stroke="{DynamicResource TextMutedBrush}"
                          StrokeThickness="1.5"
                          Fill="Transparent"
                          Width="18"
                          Height="18"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"/>
                </Button>

                <!-- 管理按钮 (线条镂空齿轮) -->
                <Button Grid.Column="3"
                        Style="{StaticResource TopIconButton}"
                        ToolTip="{x:Static svc:AppStrings.TooltipManage}"
                        Click="BtnManage_Click">
                    <Path Data="M12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15M19.4,13C19.4,12.7 19.5,12.3 19.5,12C19.5,11.7 19.4,11.3 19.4,11L21.5,9.4C21.7,9.2 21.8,9 21.6,8.7L19.6,5.3C19.5,5.1 19.2,5 19,5.1L16.5,6.1C16,5.7 15.5,5.4 14.9,5.1L14.5,2.4C14.5,2.2 14.3,2 14,2H10C9.7,2 9.5,2.2 9.5,2.4L9.1,5.1C8.5,5.3 8,5.7 7.5,6.1L5,5.1C4.8,5 4.5,5.1 4.4,5.3L2.4,8.7C2.2,9 2.3,9.2 2.5,9.4L4.6,11C4.6,11.3 4.5,11.7 4.5,12C4.5,12.3 4.6,12.7 4.6,13L2.5,14.6C2.3,14.8 2.2,15 2.4,15.3L4.4,18.7C4.5,18.9 4.8,19 5,18.9L7.5,17.9C8,18.3 8.5,18.7 9.1,18.9L9.5,21.6C9.5,21.8 9.7,22 10,22H14C14.3,22 14.5,21.8 14.5,21.6L14.9,18.9C15.5,18.7 16,18.3 16.5,17.9L19,18.9C19.2,19 19.5,18.9 19.6,18.7L21.6,15.3C21.7,15 21.7,14.8 21.5,14.6L19.4,13Z"
                          Stroke="{DynamicResource TextMutedBrush}"
                          StrokeThickness="1.5"
                          Fill="Transparent"
                          Width="18"
                          Height="18"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- 2. 分割线 -->
            <Separator Grid.Row="1"
                       Background="{DynamicResource BorderBrush}"
                       Margin="0"
                       Opacity="0.4"/>

            <!-- 3. 搜索结果列表 -->
            <ListBox x:Name="ResultListBox"
                     Grid.Row="2"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="False"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="10,6"
                     ItemContainerStyle="{StaticResource ResultItemStyle}"
                     PreviewMouseLeftButtonUp="ResultListBox_PreviewMouseLeftButtonUp"
                     PreviewMouseRightButtonUp="ResultListBox_PreviewMouseRightButtonUp"
                     MouseDoubleClick="ResultListBox_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- 数字序号 -->
                                <ColumnDefinition Width="Auto"/> <!-- 快捷键胶囊 -->
                                <ColumnDefinition Width="*"/>    <!-- 名称与目标 -->
                                <ColumnDefinition Width="Auto"/> <!-- 频次角标 -->
                            </Grid.ColumnDefinitions>

                            <!-- 数字序号直达键 (1~9, 0) -->
                            <Border Grid.Column="0"
                                    Width="24" Height="24"
                                    CornerRadius="4"
                                    Background="{DynamicResource BadgeBgBrush}"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayIndex}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           FontFamily="Consolas, Cascadia Code, monospace"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <!-- 快捷词胶囊 Badge -->
                            <Border Grid.Column="1"
                                    CornerRadius="5"
                                    Background="{DynamicResource CardBgBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    Padding="9,3"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding ShortCut}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           FontFamily="Consolas, Cascadia Code, monospace"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>

                            <!-- 名称与命令行 -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding CommandLine}"
                                           FontSize="12"
                                           FontFamily="Consolas, Cascadia Code, monospace"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- 频次指示器 -->
                            <TextBlock Grid.Column="3"
                                       Text="{Binding Freq, StringFormat='{}★ {0}'}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,4,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 4. 底部现代操作提示栏 -->
            <Border Grid.Row="3"
                    Background="{DynamicResource CardBgBrush}"
                    Padding="16,9"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource BorderBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static svc:AppStrings.HintRun}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,14,0"/>
                        <TextBlock Text="{x:Static svc:AppStrings.HintRunAsAdmin}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,14,0"/>
                        <TextBlock Text="{x:Static svc:AppStrings.HintNumberKey}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,14,0"/>
                        <TextBlock Text="{x:Static svc:AppStrings.HintTabComplete}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,14,0"/>
                        <TextBlock Text="{x:Static svc:AppStrings.HintContextMenuDir}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,14,0"/>
                        <TextBlock Text="{x:Static svc:AppStrings.HintEscHide}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>

                    <ResizeGrip Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Opacity="0.45" Cursor="SizeNWSE"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
